# ── AI Providers (at least one required for the chatbot) ──────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GOOGLE_AI_API_KEY=your_google_ai_key_here

# ── Map ───────────────────────────────────────────────────────────────────────
# Get a free token at https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# ── Fire Data ─────────────────────────────────────────────────────────────────
# Register at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# ── Air Quality ───────────────────────────────────────────────────────────────
# Register at https://docs.airnowapi.org/account/request/
# Open-Meteo is free and requires no key — used as default fallback
AIRNOW_API_KEY=your_airnow_key_here

# ── Weather (optional) ────────────────────────────────────────────────────────
# XWeather API: https://www.xweather.com/docs/weather-api
XWEATHER_CLIENT_ID=your_xweather_client_id
XWEATHER_CLIENT_SECRET=your_xweather_secret
